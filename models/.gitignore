# Per-model generated/downloaded artifacts — regenerate by rerunning the model's scripts,
# don't commit. Follows the same local (uncommitted) convention as ../data/.gitignore,
# ../de_outputs/.gitignore, ../drf_outputs/.gitignore.
*/pert_data/
*/smoke_data/
*/checkpoints/
*/cache/
*/wandb/
*/saved_models/
*/runs/
*/__pycache__/
compare_results.csv
compare_pairwise.csv
plots/

# models/data/<dataset>/ — generated data artifacts (raw.h5ad, kfold_splits.json, folds/),
# fully reproducible from prepare_data.py/prepare_split.py (deterministic seed) — nothing
# here needs to be tracked.
data/*/

# sbatch stdout/stderr — regenerated every run, not something to track.
slurm/logs/*

# EBI cluster infrastructure: one per-job GPU stats dump per GPU job we run (currently just
# connection-error placeholders — the cluster's DCGM host engine isn't reachable from these
# nodes), not something we created or need to track.
dcgm/
