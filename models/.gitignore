# Per-model generated/downloaded artifacts — regenerate by rerunning the model's scripts,
# don't commit. Follows the same local (uncommitted) convention as ../data/.gitignore,
# ../de_outputs/.gitignore, ../drf_outputs/.gitignore.
*/pert_data/
*/predictions/
*/metrics/
*/checkpoints/
*/cache/
*/wandb/
*/saved_models/
*/runs/
*/__pycache__/
compare_results.csv
compare_pairwise.csv
plots/

# models/data/<dataset>/ — generated data artifacts (raw.h5ad, kfold_splits.json, folds/),
# fully reproducible from prepare_data.py/prepare_split.py (deterministic seed) — nothing
# here needs to be tracked.
data/*/

# data/source/ is the one exception: it's not generated by our own scripts, just the manual
# gcloud storage cp destination for the raw GCS h5ad (README step 2) -- so, unlike every other
# data/*/ subdirectory, nothing ever creates it via Path.mkdir(parents=True). A fresh clone
# (e.g. a from-scratch checkout on another filesystem for a full-scale run) would otherwise
# hit gcloud/gsutil's own refusal to copy into a destination path that doesn't exist yet. Keep
# the directory itself tracked (via .gitkeep) so it always exists post-checkout, while still
# ignoring its actual (large, re-fetchable) contents.
!data/source/
data/source/*
!data/source/.gitkeep

# sbatch stdout/stderr — regenerated every run, not something to track.
slurm/logs/*

# EBI cluster infrastructure: one per-job GPU stats dump per GPU job we run (currently just
# connection-error placeholders — the cluster's DCGM host engine isn't reachable from these
# nodes), not something we created or need to track.
dcgm/
