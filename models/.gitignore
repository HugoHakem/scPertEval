# ../de_outputs/.gitignore, ../drf_outputs/.gitignore.
*/pert_data/
*/smoke_data/
*/checkpoints/
*/cache/
*/wandb/
*/saved_models/
*/runs/
*/__pycache__/
compare_results.csv
compare_pairwise.csv
plots/

# models/data/ — generated data artifacts, fully reproducible from prepare_data.py/
# prepare_split.py (deterministic seed) — nothing here needs to be tracked.
data/*_folds/
data/*.h5ad
data/*_kfold_splits.json
